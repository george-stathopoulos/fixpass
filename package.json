    "zip": "npm run build && bash bin/zip.sh"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@wordpress/scripts": "^30.0.0",
    "markdown-it": "^14.3.2"
  }
}
