{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Fixpass demo",
		"author": "George Stathopoulos",
		"description": "A small bakery site with Fixpass installed, and a page with a problem to spotlight."
	},
	"landingPage": "/wp-admin/admin.php?page=fixpass",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Bluebird Bakery"
			}
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false,
				"DISABLE_WP_CRON": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://george-stathopoulos.github.io/fixpass/downloads/fixpass.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/fixpass-seed.php",
			"data": {
				"resource": "url",
				"url": "https://george-stathopoulos.github.io/fixpass/demo/seed.php.txt"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/fixpass-seed.php';"
		}
	]
}
